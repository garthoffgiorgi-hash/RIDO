# Copy to apps/web/.env.local (gitignored, never committed) and fill in real values.

# ---------------------------------------------------------------- Supabase
# From your project: Settings -> API.

# Safe to ship to the browser — NEXT_PUBLIC_* is a promise that the value is safe to ship to a
# browser (root CLAUDE.md). These two are.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security entirely. Never NEXT_PUBLIC_, never imported into
# src/lib/supabase/client.ts or anywhere a browser can reach.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ Mapbox
# From account.mapbox.com -> Tokens. Two separate tokens, deliberately — see below.

# Safe to ship to the browser. A Mapbox PUBLIC token (starts with `pk.`) is designed to be public:
# it carries only public scopes and cannot create, modify or delete anything. Restrict it by URL
# in the Mapbox dashboard so it only works from RIDO's own origins plus http://localhost:3000.
# This renders the map and runs the rider's place search.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-only. A Mapbox SECRET token (starts with `sk.`). This is the token that measures the trip
# a fare is computed from, so it never reaches a browser and is never NEXT_PUBLIC_ — shipping it
# to the client would put the measuring instrument in the hands of the party being measured.
#
# It is a SEPARATE token rather than the one above on purpose: Mapbox enforces URL restrictions
# via the HTTP Referer header, and a server-to-server fetch sends no Referer — so a properly
# restricted public token returns 403 from our own server. Two tokens is what lets the public one
# actually be restricted.
MAPBOX_SECRET_TOKEN=

# ------------------------------------------------------------------ Stripe
# From dashboard.stripe.com. Both server-only; neither is ever NEXT_PUBLIC_.
#
# There is deliberately NO publishable key here. Driver payouts use Connect Express, whose
# onboarding is hosted by Stripe on their own domain — the driver enters bank details on
# Stripe's page, not ours. No Stripe.js, no card element, nothing Stripe-shaped reaches the
# browser. A publishable key becomes necessary the day riders are charged, and not before.

# Server-only. Creates Connect accounts and moves money. Use a TEST key (`sk_test_...`) until
# rider charging exists — see docs/decisions/0015-connect-payouts-per-ride.md: in production a
# transfer fails with `balance_insufficient` because nothing funds the platform balance yet.
STRIPE_SECRET_KEY=

# Server-only. From the webhook endpoint's own page (Developers -> Webhooks -> your endpoint ->
# "Signing secret"), NOT the API keys page — it is per-endpoint, so the local `stripe listen`
# secret and the deployed one differ and are not interchangeable.
#
# This is what makes a webhook trustworthy: the request body is signed with it, and an unsigned
# or wrongly-signed POST to /api/stripe/webhook is rejected before it can claim a driver's
# payouts are enabled. Without it set, the endpoint refuses every request rather than trusting
# any — a missing secret must never degrade into an open endpoint.
STRIPE_WEBHOOK_SECRET=
